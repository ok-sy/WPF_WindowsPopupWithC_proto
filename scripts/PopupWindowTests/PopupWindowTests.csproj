<Project Sdk="Microsoft.NET.Sdk">
  <!-- [설계 50] PopupWindow 숨김 문구(A1)·일반 VIDEO 종료 제한(A10) 회귀 검증. 실행 방법은 Program.cs 상단 주석 참고. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../popup-frameWork/Popup/Popup.csproj" />
    <Content Include="../../popup-frameWork/Popup/Media/*" Link="Media/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
