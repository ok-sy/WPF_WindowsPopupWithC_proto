<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- WPF를 띄우지 않고 실제 복구/HTTP/큐/인증 소스를 Linux와 Windows에서 검증한다. -->
  <ItemGroup>
    <Compile Include="../Popup/Services/PopupPollingRecovery.cs" Link="Services/PopupPollingRecovery.cs" />
    <Compile Include="../Popup/Services/PopupApiService.cs" Link="Services/PopupApiService.cs" />
    <Compile Include="../Popup/Services/PopupResultQueue.cs" Link="Services/PopupResultQueue.cs" />
    <Compile Include="../Popup/Services/IPopupGateway.cs" Link="Services/IPopupGateway.cs" />
    <Compile Include="../Popup/Services/ClientVersion.cs" Link="Services/ClientVersion.cs" />
    <Compile Include="../Popup/Services/Auth/*.cs" Link="Auth/%(Filename)%(Extension)" />
    <Compile Include="../Popup/Dtos/*.cs" Link="Dtos/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
