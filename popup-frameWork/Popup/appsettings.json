// ============================================================================
// popupSample(WPF 팝업 클라이언트) 실행 설정
// ----------------------------------------------------------------------------
// - 읽는 위치: EXE와 같은 폴더의 appsettings.json이 있으면 그 파일, 없으면 빌드 때 EXE에 넣은 이 파일(내장 리소스).
//   단일 EXE(-SingleFile)도 같다. 다시 빌드하지 않고 EXE 옆에 이 파일을 두어 값을 바꿀 수 있다.
// - // 주석과 끝 쉼표를 허용한다. 항목을 빼면 아래 '기본값'으로 동작한다.
// - 이 값보다 우선하는 것(설정 파일 밖에서 바꾸는 방법):
//     실행 인자  -Demo / --demo   : DemoMode=true와 같음(인메모리 Demo)
//               -Demo -Api        : API Demo(Demo 화면에서 실제 API 수동 호출, 자동 조회 없음). -Api 단독은 무시
//               --show-main       : 일반 실행에서 관리 화면을 숨기지 않고 시작(SSO·로그인 확인용, 시작 조회 오류도 안내)
//               --tray            : 트레이 아이콘 표시(Startup.TrayEnabled·환경변수보다 우선)
//     환경변수  WPF_POPUP_TRAY_ENABLED      : 트레이 표시(true/false, 1/0, yes/no, on/off) — Startup.TrayEnabled보다 우선
//               WPF_POPUP_AUTOSTART_ENABLED : 로그인 자동 시작(위와 같은 값) — Startup.AutostartEnabled보다 우선
//               POPUP_DEV_USER_ID           : 개발 전용 사번 — PopupApi.DevUserId보다 우선
//   우선순위: 실행 인자 > 환경변수 > 이 파일 > 기본값. 사용자 환경변수는 setx로 설정하고 다시 로그인한 뒤 실행부터 적용된다.
// ============================================================================
{
  "PopupApi": {
    // [모드] true: 서버를 호출하지 않고 내장 샘플 팝업만 쓰는 Demo 화면(트레이 항상 표시). false: 일반 실행(백그라운드 조회).
    // 기본값 false. 폐쇄망·배포용은 false로 둔다.
    "DemoMode": true,

    // [Demo 전용] true면 Demo 화면에 "SSO 테스트"·"로그인 테스트" 버튼을 표시(팝업 조회·결과 전송·토큰 보관 없음).
    // DemoMode=false에서는 쓰지 않는다. 기본값 false.
    "DemoSsoLoginTest": false,

    // [서버] 팝업 API 기본 주소(/p 포함). 뒤에 /api/wpf/... 경로를 붙인다. 일반 실행(DemoMode=false)에서는 필수.
    "BaseUrl": "http://localhost:8080/zero-rule-server/p",

    // [조회] 시작 직후 자동 조회 여부. false면 주기 조회만 한다. 기본값 true.
    "AutoLoadOnStartup": true,

    // [조회] 주기 조회 간격(초). 서버 응답 pollingIntervalSeconds가 있으면 서버 값 우선. 1800~3600으로 제한. 기본값 1800.
    "PollingIntervalSeconds": 1800,

    // [화면] SURVEY·QUIZ 문항 디자인 버전 "V1" | "V2". 없거나 모르는 값이면 최신(V2). 관리자 웹 SURVEY_DESIGN_VERSION과 맞춘다.
    "SurveyDesignVersion": "V2",

    "Auth": {
      // [인증] 인증 헤더 방식 "None" | "Static" | "SsoPrototype". 기본값 "None".
      //   None         : 인증 헤더 없음(서버 개발 프로파일 + DevUserId로만 사용자 지정)
      //   Static       : StaticHeader 문자열을 Authorization 헤더로 그대로 보냄
      //   SsoPrototype : SsoUrl(Windows 통합 인증)로 사번을 받아 LoginPath로 로그인 → 메모리 Bearer 토큰
      "Mode": "SsoPrototype",

      // [인증] Mode=Static일 때 Authorization 헤더 값(예: "Bearer ..."). 그 밖의 모드에서는 비워 둔다.
      "StaticHeader": "",

      // [인증] Mode=SsoPrototype일 때 SSO 주소(GET 응답 XML의 MAIN_USER_ID·MAIN_USER_CLASSI_CODE 사용). SsoPrototype에서는 필수.
      "SsoUrl": "http://localhost:8099/sso/encriptloginprocess.aspx",

      // [인증] Mode=SsoPrototype일 때 BaseUrl 뒤에 붙는 로그인 API 경로. 기본값 "/api/wpf/auth/login".
      "LoginPath": "/api/wpf/auth/login",

      // [인증] Mode=SsoPrototype일 때 정기 재로그인 주기(분). 0 이하이면 끄고 401 응답 때만 재로그인. 기본값 60.
      "PeriodicLoginMinutes": 60
    },

    // [개발 전용] X-Dev-User-Id 헤더로 보낼 사번(서버 dev-user-header=true일 때만 의미). 비우면 보내지 않는다.
    // 환경변수 POPUP_DEV_USER_ID가 있으면 그 값 우선. 배포용은 비운다. 기본값 "".
    "DevUserId": "E1001"
  },

  "Startup": {
    // [실행] 트레이 아이콘 표시(상태·진단용 메뉴: 관리 화면 열기·팝업 다시 조회·자동 실행 토글·종료). 기본값 false(백그라운드 전용).
    // --tray 실행 인자·WPF_POPUP_TRAY_ENABLED가 이 값보다 우선. Demo 모드는 이 값과 관계없이 트레이를 표시한다.
    "TrayEnabled": false,

    // [실행] 로그인 자동 시작. true: 사용자 세션 첫 일반 실행 때 HKCU Run(OksyPopupClient)에 EXE 경로를 1회 등록하고,
    // 이후 사용자가 지우거나 작업 관리자에서 끄면 다시 등록하지 않는다. false: 이 앱 등록 값을 지운다.
    // %TEMP%·빌드 출력(bin 폴더) 위치나 SYSTEM 계정 실행은 등록하지 않는다. WPF_POPUP_AUTOSTART_ENABLED가 이 값보다 우선. 기본값 true.
    "AutostartEnabled": true
  }
}
