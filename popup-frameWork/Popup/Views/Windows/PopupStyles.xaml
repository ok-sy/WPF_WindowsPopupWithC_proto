<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        모든 팝업이 공유하는 시각 규칙.
        각 Content View가 임의의 색/테두리/버튼을 다시 만들지 않고
        이 리소스를 기준으로 같은 밀도와 계층을 유지한다.
    -->
    <SolidColorBrush x:Key="PopupTextPrimaryBrush" Color="#111827"/>
    <SolidColorBrush x:Key="PopupTextSecondaryBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="PopupBorderBrush" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="PopupSoftBorderBrush" Color="#EEF0F3"/>
    <SolidColorBrush x:Key="PopupSurfaceBrush" Color="#FAFAFB"/>
    <SolidColorBrush x:Key="PopupAccentBrush" Color="#2563EB"/>

    <Style x:Key="CommonContentTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PopupTextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style x:Key="CommonDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource PopupTextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="22"/>
    </Style>

    <Style x:Key="CommonSurfaceCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PopupSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PopupSoftBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <!-- 공통 Primary Action. 기존 두꺼운 검정 외곽선 대신 면으로 계층을 만든다. -->
    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="118"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Padding" Value="22,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="#111827"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Body"
                            Background="{TemplateBinding Background}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="#1F2937"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="#374151"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Body" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Body" Property="Background" Value="#E5E7EB"/>
                            <Setter Property="Foreground" Value="#9CA3AF"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SURVEY/QUIZ 선택지는 기본 OS 모양을 쓰지 않고 같은 크기/hover/선택색을 사용한다. -->
    <Style TargetType="RadioButton">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource PopupTextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="OptionRow"
                            Background="Transparent"
                            CornerRadius="8"
                            Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18" VerticalAlignment="Top">
                                <Border x:Name="Indicator"
                                        Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1.5"
                                        CornerRadius="9"/>
                                <Border x:Name="Dot"
                                        Width="8" Height="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource PopupAccentBrush}"
                                        CornerRadius="4"
                                        Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Grid.Column="1"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OptionRow" Property="Background" Value="#F8FAFC"/>
                            <Setter TargetName="Indicator" Property="BorderBrush" Value="#93C5FD"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OptionRow" Property="Background" Value="#EFF6FF"/>
                            <Setter TargetName="Indicator" Property="BorderBrush" Value="{StaticResource PopupAccentBrush}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OptionRow" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource PopupTextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="OptionRow"
                            Background="Transparent"
                            CornerRadius="8"
                            Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Indicator"
                                    Width="18" Height="18"
                                    VerticalAlignment="Top"
                                    Background="White"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1.5"
                                    CornerRadius="4">
                                <TextBlock x:Name="CheckMark"
                                           Text="✓"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OptionRow" Property="Background" Value="#F8FAFC"/>
                            <Setter TargetName="Indicator" Property="BorderBrush" Value="#93C5FD"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OptionRow" Property="Background" Value="#EFF6FF"/>
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource PopupAccentBrush}"/>
                            <Setter TargetName="Indicator" Property="BorderBrush" Value="{StaticResource PopupAccentBrush}"/>
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="OptionRow" Property="Opacity" Value="0.45"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
