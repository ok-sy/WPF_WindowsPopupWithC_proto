<Window x:Class="Popup.Views.Windows.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PopupWindow"
        Width="760"
        Height="620"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/popupSample;component/Views/Windows/PopupStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Window.Resources>

    <!--
    바깥 여백

    역할
    Border의 그림자가 잘리지 않도록
    Window 가장자리에 빈 공간을 만든다.
    -->
    <Grid x:Name="PopupOuterGrid"
          Margin="24">

        <!--
        팝업의 실제 흰색 몸체

        역할
        배경, 둥근 모서리, 테두리,
        그림자를 담당한다.
        -->
        <Border x:Name="PopupBodyBorder"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0"
                CornerRadius="6">

            <Border.Effect>

                <!--
                팝업 바깥쪽에
                그림자 효과를 적용한다.
                -->
                <DropShadowEffect Color="Black"
                                  BlurRadius="22"
                                  ShadowDepth="4"
                                  Direction="270"
                                  Opacity="0.28"/>

            </Border.Effect>

            <!--
            팝업 전체를 세로 세 부분으로 나눈다.

            0번 행
            상단바 Header

            1번 행
            실제 팝업 내용

            2번 행
            하단 Footer 영역
            -->
            <!-- Border의 CornerRadius는 자식 콘텐츠를 자르지 않으므로 공통 Grid에 Clip을 적용한다. -->
            <Grid x:Name="PopupBodyContent"
                  SizeChanged="PopupBodyContent_SizeChanged">

                <Grid.RowDefinitions>

                    <!--
                    공통 Header 전용 행

                    PopupOptions.ShowHeader 값에 따라
                    PopupWindow.xaml.cs에서 높이를 변경한다.

                    ShowHeader = true
                    → Header 높이를 40으로 유지

                    ShowHeader = false
                    → Header 높이를 0으로 만들어
                      제목과 고정 로고뿐 아니라
                      Header가 차지하던 공간까지 제거
                    -->
                    <RowDefinition x:Name="HeaderRow"
                    Height="40"/>

                    <!--
                    실제 팝업 내용이
                    남은 공간을 모두 사용한다.
                    -->
                    <RowDefinition Height="*"/>

                    <!--
                    하단 Footer 높이
                    -->
                    <RowDefinition x:Name="FooterRow"
                                   Height="80"/>

                </Grid.RowDefinitions>

                <!--
                공통 상단바 Header

                역할
                팝업 제목을 표시하고
                창을 드래그할 수 있게 한다.
                -->
                <!--
                공통 상단 Header 영역

                PopupOptions.ShowHeader 값에 따라
                전체 영역을 표시하거나 숨긴다.
                -->
                <Border x:Name="HeaderArea"
                        Grid.Row="0"
                        Background="Black"
                        CornerRadius="6,6,0,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <!--
                            제목 영역이
                            남은 공간을 모두 사용한다.
                            -->
                            <ColumnDefinition Width="*"/>

                            <!--
                            POL-02-01 : 창 구조 — 고정 로고가 필요한 크기만 사용한다(상단 X 버튼은 없다).
                            -->
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <!--
                        팝업 제목

                        x:Name을 지정했기 때문에
                        PopupWindow.xaml.cs에서
                        제목을 변경할 수 있다.
                        -->
                        <TextBlock x:Name="PopupTitleText"
                                   Grid.Column="0"
                                   Margin="18,0,12,0"
                                   VerticalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   Text="팝업 제목"/>

                        <!-- 고정 로고: 닫기 동작 없이 표시 -->
                        <Image x:Name="HeaderLogo" Grid.Column="1"
                               Source="/popupSample;component/Resources/HeaderLogo.png"
                               Width="100" Height="24" Margin="0,0,18,0"
                               Stretch="Uniform" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>

                    </Grid>

                </Border>
                <!--
                    헤더가 없는 팝업에서 사용하는
                    투명한 창 이동 영역

                    역할
                    ShowHeader가 false인 SURVEY 또는 QUIZ 팝업도
                    창 상단의 빈 공간을 잡고 이동할 수 있게 한다.

                    PopupContent에는 현재 Margin="24"가 적용되어 있으므로
                    높이 24 영역은 실제 콘텐츠와 겹치지 않는다.
                -->
                <Border x:Name="HeaderlessDragArea"
                                Grid.Row="1"
                                Height="24"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                Panel.ZIndex="10"
                                Visibility="Collapsed"
                                MouseLeftButtonDown="Header_MouseLeftButtonDown"/>
                <!--
                ContentControl

                역할
                실제 팝업 내용을 끼워 넣는 자리다.

                PopupOptions의 Content에 전달된
                TextPopupView
                ImagePopupView
                SurveyPopupView
                VideoPopupView 등이 이 자리에 표시된다.
                -->
                <ContentControl x:Name="PopupContent"
                Grid.Row="1"
                Margin="28,24,28,24"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"/>

                <!--
                공통 하단 Footer 영역

                x:Name을 지정했기 때문에
                PopupOptions의 ShowFooter 값에 따라
                Footer 전체를 표시하거나 숨길 수 있다.
                -->
                <Grid x:Name="FooterArea"
                      Grid.Row="2"
                      Margin="28,8,28,16">

                    <Grid.ColumnDefinitions>

                        <!--
                        체크박스 영역이
                        남은 공간을 모두 사용한다.
                        -->
                        <ColumnDefinition Width="*"/>

                        <!--
                        닫기 버튼이 필요한 크기만 사용한다.
                        -->
                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <!--
                    '{N}일간 보지 않기' 체크박스

                    x:Name을 지정했기 때문에
                    PopupOptions의 ShowDoNotShowAgain 값에 따라
                    표시하거나 숨길 수 있다.
                    문구의 N은 PopupWindow 생성자가 실제 숨김 일수(서버 hideDays, 없으면 30)로 채운다.
                    아래 Content는 디자이너 표시용 기본값이다.
                    -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="FooterResponseProgressText" Visibility="Collapsed" FontSize="12"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{StaticResource PopupTextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <CheckBox x:Name="DoNotShowAgainCheckBox"
                              Grid.Column="0"
                              VerticalAlignment="Center"
                              FontSize="14"
                              Content="30일간 보지 않기"/>
                    </StackPanel>

                    <!--
                    하단 Footer 버튼(닫기·바로가기·제출)

                    CloseButton_Click 이벤트를 사용한다.
                    (상단 X 버튼은 없다)

                    POL-02-03 : 푸터 역할
                    POL-05-02 : 완료·화면 이탈
                    FooterAuxCloseButton: 정책상 제출 전 이탈이 허용될 때만 보이는 보조 닫기.
                    VIDEO+QUIZ(재생 실패 — 완료 전 닫기 허용 옵션은 없음), QUIZ(미달 1회 이후 + Overlay 꺼짐)에서만 표시한다.
                    -->
                    <!--
                    POL-02-03 : 푸터 역할
                    POL-10-03 : 완료·숨김·연기
                    FooterLaterButton: "나중에 보기". showFooter·showLater가 모두 true일 때만 보인다.
                    누르면 결과 LATER로 닫고 다음 조회 주기에 다시 표시된다. 완료 기준(VIDEO·QUIZ) 전에도 누를 수 있으며 완료 기준 전 유일한 화면 이탈 버튼이다(완료 전 닫기 허용 옵션 없음).
                    -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FooterLaterButton"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Content="나중에 보기"
                                Margin="0,0,10,0"
                                Visibility="Collapsed"
                                Click="LaterButton_Click"/>
                        <Button x:Name="FooterAuxCloseButton"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Content="닫기"
                                Margin="0,0,10,0"
                                Visibility="Collapsed"
                                Click="CloseButton_Click"/>
                        <Button x:Name="FooterCloseButton"
                                Style="{StaticResource ActionButtonStyle}"
                                Content="닫기"
                                Click="CloseButton_Click"/>
                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>
