<UserControl x:Class="Popup.Views.Contents.SurveyPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="700" FontSize="14" MaxWidth="760">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/popupSample;component/Views/Windows/PopupStyles.xaml"/>
                <ResourceDictionary Source="/popupSample;component/Views/Contents/SurveyStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource SurveyContentBackground}">

        <Grid.RowDefinitions>
            <!-- 설문 제목과 설명 -->
            <RowDefinition Height="Auto"/>

            <!-- 질문 목록 -->
            <RowDefinition Height="*"/>

            <!-- 하단 제출 영역 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 설문 상단 영역 -->
        <Border Grid.Row="0"
            Padding="0,4,0,10">

            <StackPanel>

                <!-- 설문 제목 -->
                <TextBlock x:Name="SurveyTitleText"
                           Text="설문조사"
                           Style="{StaticResource CommonContentTitleStyle}"
                           FontSize="25" Foreground="{StaticResource SurveySelectedText}"
                           TextWrapping="Wrap"/>
                <!-- [TODO55] 제목 서식(surveyTitleBlocks)이 있으면 위 일반 문자열 대신 문단으로 표시한다. -->
                <StackPanel x:Name="SurveyTitleRich" Visibility="Collapsed"/>

                <!-- 설문 설명 -->
                <TextBlock x:Name="SurveyDescriptionText"
                           Margin="0,2,0,0"
                           Text="아래 문항에 응답해주세요."
                           Style="{StaticResource CommonDescriptionTextStyle}" Foreground="{StaticResource SurveyMutedText}"/>
                <!-- [TODO55] 설명 서식(descriptionBlocks) -->
                <StackPanel x:Name="SurveyDescriptionRich" Margin="0,2,0,0" Visibility="Collapsed"/>

            </StackPanel>
        </Border>

        <!-- 질문 목록 영역 -->
        <ScrollViewer x:Name="QuestionScrollViewer" Grid.Row="1"
                      Style="{StaticResource SurveyScrollViewerStyle}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <!--
                코드에서 질문 UI를 만들어 이 StackPanel에 추가한다.

                SingleChoice  → RadioButton
                MultipleChoice→ CheckBox
                Text          → TextBox
            -->
            <StackPanel x:Name="QuestionListPanel"
                Margin="0,4,0,20"/>

        </ScrollViewer>

        <!-- 설문 하단 영역 -->
        <Border x:Name="SubmissionArea" Grid.Row="2"
            Padding="0,14,0,0"
            BorderBrush="{StaticResource SurveyCardBorder}"
            BorderThickness="0,1,0,0">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 필수 문항 안내 -->
                <TextBlock x:Name="RequiredProgressText" Grid.Column="0"
                   Margin="0,0,12,0"
                   VerticalAlignment="Center"
                   Text="* 표시된 문항은 필수 응답입니다."
                   FontSize="13"
                   Foreground="{StaticResource SurveyMutedText}"
                   TextWrapping="Wrap"/>

                <!-- 제출 버튼 -->
                <Button x:Name="SubmitButton"
                        Style="{StaticResource SurveySubmitButtonStyle}"
                        Grid.Column="1"
                        Content="제출"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="SubmitButton_Click"/>

            </Grid>
        </Border>

    </Grid>
</UserControl>
