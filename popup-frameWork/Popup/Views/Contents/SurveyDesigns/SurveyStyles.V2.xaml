<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- POL-06-03 : 표현·수명 — Survey design V2 (2026-10-18): color rule below, plus selection UX (no radio/checkbox indicator,
         check + accent ring only after selection, no bold/color change on selection, separate focus outline, choice hints).
         Version files are self-contained snapshots: change the newest one or add a new version instead of editing an old one.
         Selected by appsettings PopupApi.SurveyDesignVersion (see SurveyDesign.cs). -->
    <!-- Survey-only monochrome tokens; outlined rows and compact chips retain separate templates. -->
    <!-- Color rule: white content background, no question card surface, white choices with a light border,
         selected choice = accent border (popup common accent #171717) + check mark on rows, base text #222222. -->
    <!-- POL-06-03 : 표현·수명 — White body (was #F5F6F8 with white question cards). PopupWindow paints the body/footer with this too. -->
    <SolidColorBrush x:Key="SurveyContentBackground" Color="White" />
    <!-- POL-06-03 : 표현·수명 — Chips have no check column (selection = accent ring only), so nothing is reserved. Used for rich option wrapping width. -->
    <sys:Double x:Key="SurveyChipCheckWidth">0</sys:Double>
    <!-- POL-06-03 : 표현·수명 — No bold on selection, so the selected-bold height reservation (StableChoiceText) is off. Missing key = on (V1). -->
    <sys:Boolean x:Key="SurveyReserveSelectedBold">False</sys:Boolean>
    <!-- POL-06-03 : 표현·수명 — Show "하나 선택" / "여러 개 선택 가능" under choice questions. Missing key = off (V1). -->
    <sys:Boolean x:Key="SurveyShowChoiceHint">True</sys:Boolean>
    <!-- Hover border of choices. -->
    <SolidColorBrush x:Key="SurveyIndicatorBorder" Color="#8C8C8C" />
    <SolidColorBrush x:Key="SurveyCardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurveyCardBorder" Color="#E5E5E5" />
    <SolidColorBrush x:Key="SurveySurfaceBrush" Color="White" />
    <SolidColorBrush x:Key="SurveyTextBrush" Color="#222222" />
    <SolidColorBrush x:Key="SurveyMutedText" Color="#737373" />
    <SolidColorBrush x:Key="SurveyPlaceholderBrush" Color="#A3A3A3" />
    <SolidColorBrush x:Key="SurveyButtonBackgroundBrush" Color="#4A4A4F" />
    <SolidColorBrush x:Key="SurveyFocusBorderBrush" Color="#737373" />
    <SolidColorBrush x:Key="SurveySelectedBackground" Color="White" />
    <SolidColorBrush x:Key="SurveySelectedBorder" Color="#171717" />
    <SolidColorBrush x:Key="SurveySelectedText" Color="#222222" />
    <SolidColorBrush x:Key="SurveyHoverBackground" Color="#F1F1F1" />
    <SolidColorBrush x:Key="SurveyPressedBackground" Color="#E2E2E2" />
    <SolidColorBrush x:Key="SurveyDisabledBackground" Color="#E5E5E5" />
    <SolidColorBrush x:Key="SurveySubmitHoverBrush" Color="#3D3D42" />
    <SolidColorBrush x:Key="SurveySubmitPressedBrush" Color="#303035" />
    <SolidColorBrush x:Key="SurveyScrollThumbBrush" Color="#D4D4D4" />
    <SolidColorBrush x:Key="SurveyScrollThumbHoverBrush" Color="#A3A3A3" />
    <SolidColorBrush x:Key="SurveyRowHoverBackground" Color="#F5F5F5" />
    <SolidColorBrush x:Key="SurveyRowSelectedBackground" Color="White" />
    <Thickness x:Key="SurveyCardPadding">20,20,20,18</Thickness>
    <Thickness x:Key="SurveyCardSpacing">0,0,0,14</Thickness>
    <Thickness x:Key="SurveyAnswerSpacing">0,14,0,0</Thickness>
    <Thickness x:Key="SurveyChoicePadding">14,10</Thickness>
    <Thickness x:Key="SurveyChoiceFocusPadding">13,9</Thickness>
    <CornerRadius x:Key="SurveyCardRadius">0</CornerRadius>
    <!-- POL-06-03 : 표현·수명 — No question card surface: questions are separated by vertical spacing and a thin bottom line
         (the code removes the line under the last question). No horizontal padding, so the number/title/choices
         start at the same line as the survey title; the window content margin keeps the side gutter. -->
    <Style x:Key="SurveyQuestionCardStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource SurveyCardBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="{StaticResource SurveyCardRadius}" />
        <Setter Property="Padding" Value="0,20,0,22" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="SurveyFocusVisualStyle" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <!-- POL-06-03 : 표현·수명 — Focus is a dashed outline outside the selection ring, so focus and selection are visible together. -->
                    <Rectangle Margin="-4" Stroke="{StaticResource SurveySelectedBorder}" StrokeThickness="1.5" StrokeDashArray="2 2" RadiusX="9" RadiusY="9" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SurveyChoiceStyle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{StaticResource SurveyTextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurveySurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurveyCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource SurveyChoicePadding}" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SurveyFocusVisualStyle}" />
    </Style>
    <Style x:Key="SurveyOptionRowStyle" TargetType="ToggleButton" BasedOn="{StaticResource SurveyChoiceStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style x:Key="SurveyOptionChipStyle" TargetType="ToggleButton" BasedOn="{StaticResource SurveyChoiceStyle}">
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <!--
        POL-06-03 : 표현·수명
        Choice corner radius 6 (was 11).
        Choice templates (single and multiple share them; the "하나 선택" / "여러 개 선택 가능" hint tells them apart).
        Before selection nothing is drawn but the light border. Rows reserve a right check column (28) so text never moves;
        chips reserve nothing (equal left/right padding) and show selection with the ring only, because a check would change the chip width.
        Selection = 2px accent ring drawn over the 1px border (no size change) + #171717 check on rows. Selection does not change
        FontWeight/Foreground, so FONT EDIT run formatting is kept. Trigger priority (later wins): hover < selected < pressed < disabled.
        Keyboard focus = SurveyFocusVisualStyle outline. Disabled keeps the current selection visible, dimmed.
    -->
    <ControlTemplate x:Key="SurveyChoiceRowTemplate" TargetType="ToggleButton">
        <Grid x:Name="Root">
            <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    <Path x:Name="CheckMark" Grid.Column="1" Width="14" Height="10" Stretch="Uniform" Stroke="{StaticResource SurveySelectedBorder}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 1,5 L 5,9 L 13,1" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <Border x:Name="SelectionRing" CornerRadius="6" BorderThickness="2" BorderBrush="{StaticResource SurveySelectedBorder}" Visibility="Hidden" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Card" Property="Background" Value="{StaticResource SurveyRowHoverBackground}" />
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource SurveyIndicatorBorder}" />
            </MultiTrigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible" />
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Card" Property="Background" Value="{StaticResource SurveyPressedBackground}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                <Setter Property="Foreground" Value="{StaticResource SurveyPlaceholderBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="SurveyChoiceChipTemplate" TargetType="ToggleButton">
        <Grid x:Name="Root">
            <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <Border x:Name="SelectionRing" CornerRadius="6" BorderThickness="2" BorderBrush="{StaticResource SurveySelectedBorder}" Visibility="Hidden" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Card" Property="Background" Value="{StaticResource SurveyHoverBackground}" />
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource SurveyIndicatorBorder}" />
            </MultiTrigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="True" />
                    <Condition Property="IsEnabled" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Card" Property="Background" Value="{StaticResource SurveyPressedBackground}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                <Setter Property="Foreground" Value="{StaticResource SurveyPlaceholderBrush}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="SurveyRadioButtonStyle" TargetType="RadioButton" BasedOn="{StaticResource SurveyOptionRowStyle}">
        <Setter Property="Template" Value="{StaticResource SurveyChoiceRowTemplate}" />
    </Style>
    <Style x:Key="SurveyCheckBoxRowStyle" TargetType="CheckBox" BasedOn="{StaticResource SurveyOptionRowStyle}">
        <Setter Property="Template" Value="{StaticResource SurveyChoiceRowTemplate}" />
    </Style>
    <Style x:Key="SurveyChoiceChipStyle" TargetType="RadioButton" BasedOn="{StaticResource SurveyOptionChipStyle}">
        <Setter Property="Template" Value="{StaticResource SurveyChoiceChipTemplate}" />
    </Style>
    <Style x:Key="SurveyCheckBoxChipStyle" TargetType="CheckBox" BasedOn="{StaticResource SurveyOptionChipStyle}">
        <Setter Property="Template" Value="{StaticResource SurveyChoiceChipTemplate}" />
    </Style>
    <Style x:Key="SurveyScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="MaxWidth" Value="8" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBody" Background="{StaticResource SurveyScrollThumbBrush}" CornerRadius="4" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource SurveyScrollThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource SurveyScrollThumbHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SurveyScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SurveyScrollThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SurveyScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Margin="10,0,0,0" Style="{StaticResource SurveyScrollBarStyle}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SurveyTextBoxStyle" TargetType="TextBox">
        <Setter Property="MaxHeight" Value="180" />
        <Setter Property="Background" Value="{StaticResource SurveySurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurveyCardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Foreground" Value="{StaticResource SurveySelectedText}" />
        <Setter Property="CaretBrush" Value="{StaticResource SurveySelectedText}" />
        <Setter Property="SelectionBrush" Value="{StaticResource SurveySelectedBorder}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SurveyFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Style="{StaticResource SurveyScrollViewerStyle}" />
                            <TextBlock x:Name="Placeholder" Text="추가 의견이 있다면 자유롭게 작성해주세요." Margin="{TemplateBinding Padding}" Foreground="{StaticResource SurveyPlaceholderBrush}" TextWrapping="Wrap" IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource SurveyFocusBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SurveySubmitButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="46" />
        <Setter Property="MinWidth" Value="132" />
        <Setter Property="Padding" Value="24,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SurveySurfaceBrush}" />
        <Setter Property="Background" Value="{StaticResource SurveyButtonBackgroundBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SurveyFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2" CornerRadius="11" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{StaticResource SurveySubmitHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{StaticResource SurveySubmitPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{StaticResource SurveySelectedBorder}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Body" Property="Background" Value="{StaticResource SurveyDisabledBackground}" />
                            <Setter Property="Foreground" Value="{StaticResource SurveyPlaceholderBrush}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
