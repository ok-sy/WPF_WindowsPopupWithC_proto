<UserControl x:Class="Popup.Views.Contents.ImagePopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Popup;component/Views/Windows/PopupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ImageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CommonContentTitleStyle}">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#111827"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>
            <Style x:Key="ImageDescriptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CommonDescriptionTextStyle}">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#4B5563"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="23"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="ImageTitleText" Grid.Row="0" Style="{StaticResource ImageTitleTextStyle}"/>
        <Grid x:Name="AdaptiveLayoutGrid" Grid.Row="1" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- A flexible viewport clips fixed FIT_TO_IMAGE dimensions around the center. -->
            <Border x:Name="ImageContainer" Grid.Row="0" Background="#FAFAFB"
                    BorderBrush="#EEF0F3" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <Image x:Name="PopupImage" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
            <Border x:Name="DescriptionContainer" Grid.Row="1" Background="#FAFAFB"
                    BorderBrush="#EEF0F3" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,14,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="ImageDescriptionText" Style="{StaticResource ImageDescriptionTextStyle}"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
