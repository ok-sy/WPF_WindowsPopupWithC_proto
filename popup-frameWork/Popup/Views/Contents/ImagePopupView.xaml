<UserControl x:Class="Popup.Views.Contents.ImagePopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="760"
             d:DesignHeight="560">

    <UserControl.Resources>

        <!--
        이미지 제목 스타일

        이미지 콘텐츠 상단에 표시되는
        제목의 공통 디자인을 설정한다.
        -->
        <Style x:Key="ImageTitleTextStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="22"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Foreground"
                    Value="#111827"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

            <Setter Property="Margin"
                    Value="0,0,0,16"/>

        </Style>

        <!--
        이미지 설명 스타일

        이미지 옆 또는 아래에 표시되는
        설명 문구의 디자인을 설정한다.
        -->
        <Style x:Key="ImageDescriptionTextStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#4B5563"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

            <Setter Property="LineHeight"
                    Value="23"/>

        </Style>

    </UserControl.Resources>

    <!--
    ImagePopupView 전체 레이아웃

    첫 번째 행
    이미지 제목

    두 번째 행
    이미지와 설명이 들어가는 가변 레이아웃
    -->
    <Grid>

        <Grid.RowDefinitions>

            <!--
            이미지 제목 영역
            -->
            <RowDefinition Height="Auto"/>

            <!--
            이미지 및 설명 영역
            -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!--
        이미지 제목

        코드 비하인드에서 전달받은 제목을
        이 TextBlock에 표시한다.
        -->
        <TextBlock x:Name="ImageTitleText"
                   Grid.Row="0"
                   Style="{StaticResource ImageTitleTextStyle}"
                   Text="이미지 제목"/>

        <!--
        이미지 비율에 따라 구조가 변경되는 영역

        가로형 및 정사각형
        이미지 위 / 설명 아래

        세로형
        이미지 왼쪽 / 설명 오른쪽
        -->
        <Grid x:Name="AdaptiveLayoutGrid"
              Grid.Row="1">

            <!--
            코드 비하인드에서 행 구조를 동적으로 변경하므로
            기본값만 설정한다.
            -->
            <Grid.RowDefinitions>

                <RowDefinition x:Name="ContentFirstRow"
                               Height="*"/>

                <RowDefinition x:Name="ContentSecondRow"
                               Height="Auto"/>

            </Grid.RowDefinitions>

            <!--
            코드 비하인드에서 열 구조를 동적으로 변경하므로
            기본값만 설정한다.
            -->
            <Grid.ColumnDefinitions>

                <ColumnDefinition x:Name="ContentFirstColumn"
                                  Width="*"/>

                <ColumnDefinition x:Name="ContentSecondColumn"
                                  Width="0"/>

            </Grid.ColumnDefinitions>

            <!--
            이미지 바깥쪽 카드 영역

            실제 이미지의 위치는
            코드 비하인드에서 Grid.Row 및 Grid.Column을
            동적으로 변경한다.
            -->
            <Border x:Name="ImageContainer"
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="#F9FAFB"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="0">

                <!--
                외부 URL 또는 프로젝트 내부 이미지를
                화면에 표시한다.

                Stretch="Uniform"이므로
                이미지 비율이 유지된다.

                [2026-09-23-03] 정렬은 Stretch가 기본이다.
                ADAPTIVE는 팝업 크기가 기준이므로 이미지가 배정된 영역을
                Uniform으로 채워야 팝업 안에 맞춰진다. Center 정렬이면
                Image가 영역 크기와 무관하게 자기 크기를 유지해,
                영역보다 큰 경우 좌우가 잘려 보였다.

                FIT_TO_IMAGE는 코드에서 Width/Height와 Center 정렬을
                직접 지정하므로 이 기본값의 영향을 받지 않는다.
                -->
                <Image x:Name="PopupImage"
                Stretch="Uniform"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>

            </Border>

            <!--
            이미지 설명 카드 영역

            이미지 비율에 따라
            이미지 아래 또는 이미지 오른쪽에 배치된다.
            -->
            <Border x:Name="DescriptionContainer"
                    Grid.Row="1"
                    Grid.Column="0"
                    Background="#F3F4F6"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,14,0,0">

                <!--
                이미지 설명 문구
                -->
                <TextBlock x:Name="ImageDescriptionText"
                           Style="{StaticResource ImageDescriptionTextStyle}"
                           Text="이미지 설명이 표시됩니다."/>

            </Border>

        </Grid>

    </Grid>

</UserControl>