<UserControl x:Class="Popup.Views.Contents.TextPopupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             MinWidth="320"
             MinHeight="240">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/popupSample;component/Views/Windows/PopupStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!--
        본문의 일반 글자 스타일

        역할
        글자 크기, 색상, 줄 간격,
        자동 줄바꿈을 통일한다.
        -->
        <Style x:Key="BodyTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource CommonDescriptionTextStyle}">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Foreground"
                    Value="#374151"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

            <Setter Property="LineHeight"
                    Value="24"/>

            
        </Style>

       
        
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
    TextPopupView의 전체 본문 영역
    -->
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- POL-03-01 : 저장·표시 경계 — 텍스트 팝업 전용 제목/설명 영역(ContentHeaderPanel)은 없다. 제목·설명은 서식 본문으로 작성한다. 0행은 비워 둔다. -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility ="Disabled">

            <StackPanel>
            <TextBlock x:Name="PlainTextBlock"
                       Margin="0,0,0,16"
                       Style="{StaticResource BodyTextStyle}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed"/>

            <!-- POL-03-01 : 저장·표시 경계 — 서식 본문(textBlocks). 문단마다 TextBlock을 넣으며, 있으면 PlainTextBlock 대신 표시한다. -->
            <StackPanel x:Name="RichTextPanel"
                        Margin="0,0,0,16"
                        Visibility="Collapsed"/>

            </StackPanel>

        </ScrollViewer>

        <TextBlock x:Name="BottomDescriptionText"
                   Grid.Row="2"
                   Margin="0,16,0,0"
                   Padding="14"
                   Style="{StaticResource BodyTextStyle}"
                   Background="#FAFAFB"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

    </Grid>

</UserControl>
