<Window x:Class="Popup.DemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Popup Demo Mode" Height="760" Width="1080" MinHeight="600" MinWidth="820"
        Background="#F5F6F8" Foreground="#20242B" FontFamily="Malgun Gothic" FontSize="13" ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#20242B"/>
            <Setter Property="BorderBrush" Value="#D7DBE1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#20242B"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#68707C"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TabItem"><Setter Property="Padding" Value="8,8"/></Style>
        <Style x:Key="JsonText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="BorderBrush" Value="#E0E3E8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Popup Demo" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="서버 없이 팝업과 결과 전송을 확인합니다." Foreground="#68707C" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="상태 초기화" Margin="0,0,8,0" Click="ResetServerButton_Click" ToolTip="숨김·완료 상태와 처리한 결과를 초기화합니다."/>
                <Button Content="전체 실행" Margin="0" Style="{StaticResource PrimaryButton}" Click="OpenAllPopupsButton_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#E0E3E8" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="팝업 실행" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="시연할 샘플" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="ScenarioCombo" SelectedIndex="0" SelectionChanged="ScenarioCombo_SelectionChanged">
                                <ComboBoxItem Content="텍스트" Tag="DEMO-TEXT-001"/>
                                <ComboBoxItem Content="이미지" Tag="DEMO-IMAGE-001"/>
                                <ComboBoxItem Content="동영상" Tag="DEMO-VIDEO-001"/>
                                <ComboBoxItem Content="설문" Tag="DEMO-SURVEY-001"/>
                                <ComboBoxItem Content="퀴즈" Tag="DEMO-QUIZ-001"/>
                                <ComboBoxItem Content="동영상 + 퀴즈" Tag="DEMO-VIDEO-QUIZ"/>
                                <ComboBoxItem Content="푸터 바로가기" Tag="DEMO-FOOTER-LINK"/>
                            </ComboBox>
                            <Button Content="선택한 샘플 실행" Style="{StaticResource PrimaryButton}" Click="OpenSelectedPopupButton_Click"/>
                            <Button Content="옵션 설정" Click="EditOptionsButton_Click"/>
                            <Button Content="선택한 옵션 기본값 복원" Click="ResetOptionsButton_Click"/>
                            <Border Background="#F5F6F8" Padding="12" CornerRadius="6" Margin="0,12,0,16">
                                <TextBlock x:Name="ScenarioSummaryText" TextWrapping="Wrap" Foreground="#374151" LineHeight="22"/>
                            </Border>
                            <TextBlock Text="설정창에서 공통 창·콘텐츠·문항 옵션을 편집하세요. 샘플별 설정은 다음 실행에 적용되며 앱 종료 시 초기화됩니다." Style="{StaticResource Hint}"/>
                            <TextBlock Text="숨김·완료된 팝업은 다음 실행에서 제외됩니다. 다시 보려면 상단의 상태 초기화를 누르세요. 상태 초기화는 편집한 옵션을 유지합니다." Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="#E0E3E8" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,12,0,0">
                        <TextBlock x:Name="ServerStateText" Foreground="#68707C" Text="숨김 0 · 완료 0"/>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#E0E3E8" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="0.7*"/>
                        <RowDefinition Height="8"/><RowDefinition Height="1.3*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="로그 지우기" Margin="12,0,0,0" Padding="10,6" Click="ClearLogButton_Click"/>
                        <TextBlock Text="결과 전송 로그" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#F5F6F8" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <TextBlock x:Name="QuizScoreText" Text="퀴즈 완료 후 점수와 통과 여부가 표시됩니다." TextWrapping="Wrap" Foreground="#374151"/>
                    </Border>
                    <ListBox Grid.Row="2" x:Name="ResultLogList" FontFamily="Consolas" FontSize="12" BorderBrush="#E0E3E8"
                             SelectionChanged="ResultLogList_SelectionChanged" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="#E0E3E8" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
                    <TabControl x:Name="DetailTabs" Grid.Row="4" BorderThickness="0">
                        <TabItem Header="Request · 요청">
                            <DockPanel Margin="0,8,0,0">
                                <Button x:Name="CopyRequestButton" DockPanel.Dock="Top" Content="요청 JSON 복사" HorizontalAlignment="Right" IsEnabled="False" Tag="REQUEST" Click="CopyJsonButton_Click"/>
                                <TextBox x:Name="RequestJsonText" Style="{StaticResource JsonText}"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Response · 응답">
                            <DockPanel Margin="0,8,0,0">
                                <Button x:Name="CopyResponseButton" DockPanel.Dock="Top" Content="응답 JSON 복사" HorizontalAlignment="Right" IsEnabled="False" Tag="RESPONSE" Click="CopyJsonButton_Click"/>
                                <TextBox x:Name="ResponseJsonText" Style="{StaticResource JsonText}"/>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                    <TextBlock Grid.Row="5" x:Name="CopyStatusText" Text="로그를 선택하면 요청·응답 JSON을 확인하고 복사할 수 있습니다." Foreground="#68707C" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
