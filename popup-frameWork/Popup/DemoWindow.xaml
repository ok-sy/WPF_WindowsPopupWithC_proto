<Window x:Class="Popup.DemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Popup Demo Mode" Height="780" Width="1080" MinHeight="600" MinWidth="820"
        Background="#F5F6F8" Foreground="#20242B" FontFamily="Malgun Gothic" FontSize="13" ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#20242B"/>
            <Setter Property="BorderBrush" Value="#D7DBE1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#20242B"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#68707C"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TabItem"><Setter Property="Padding" Value="8,8"/></Style>
        <Style x:Key="JsonText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="BorderBrush" Value="#E0E3E8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Popup Demo" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <!-- POL-14-02 : Demo 모드 — 모드는 실행 인자로 정한다(demo 로컬 샘플, demo + api API 연결). 창 안 전환은 하지 않고 현재 모드만 표시한다. -->
                    <Border x:Name="ModeBadge" Background="#E8F1EC" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ModeBadgeText" Text="로컬 샘플" Foreground="#1F6B45" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="HeaderSubtitleText" Text="서버 없이 팝업과 결과 전송을 확인합니다." Foreground="#68707C" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <Button Content="JSON Validator · JSON 검증 / 유형별 예시" Click="JsonValidatorButton_Click" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,5" ToolTip="API 호출 없이 JSON 검증·예시 복사·보정 결과 확인"/>\n                <TextBlock x:Name="ModeHintText" Foreground="#8A919C" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="API 연결로 확인하려면 popupSample.exe --demo --api 로 실행"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#E0E3E8" BorderThickness="1" CornerRadius="8" Padding="5" Grid.ColumnSpan="2" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="LeftPanelTitle" Text="팝업 실행" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                        <!-- POL-14-02 : Demo 모드 — 인메모리 Demo 전용(샘플·옵션·상태 초기화·인증 테스트). API Demo에서는 숨긴다. -->
                        <StackPanel x:Name="InMemoryPanel">
                            <TextBlock Text="시연할 샘플" Style="{StaticResource Label}" />
                            <ComboBox x:Name="ScenarioCombo" SelectedIndex="0" SelectionChanged="ScenarioCombo_SelectionChanged">
                                <ComboBoxItem Content="텍스트" Tag="DEMO-TEXT-001"/>
                                <ComboBoxItem Content="이미지" Tag="DEMO-IMAGE-001"/>
                                <ComboBoxItem Content="동영상" Tag="DEMO-VIDEO-001"/>
                                <ComboBoxItem Content="설문" Tag="DEMO-SURVEY-001"/>
                                <ComboBoxItem Content="설문 (디자인 평가)" Tag="DEMO-SURVEY-PLAIN"/>
                                <ComboBoxItem Content="퀴즈" Tag="DEMO-QUIZ-001"/>
                                <ComboBoxItem Content="동영상 + 퀴즈" Tag="DEMO-VIDEO-QUIZ"/>
                                <ComboBoxItem Content="푸터 바로가기" Tag="DEMO-FOOTER-LINK"/>
                            </ComboBox>
                            <Button Content="옵션 설정" Click="EditOptionsButton_Click"/>
                            <Button Content="선택한 샘플 옵션 전체 기본값 복원" Click="ResetOptionsButton_Click"
                                    ToolTip="이 샘플의 모든 옵션을 처음 값으로 되돌립니다. 그룹별 복원은 옵션 설정 창의 각 탭에서 합니다."/>
                            <Border Background="#F5F6F8" Padding="12" CornerRadius="6" Margin="0,12,0,16">
                                <TextBlock x:Name="ScenarioSummaryText" TextWrapping="Wrap" Foreground="#374151" LineHeight="22"/>
                            </Border>
                            <TextBlock Text="옵션 설정 창에서 탭별로 옵션을 편집하세요. 샘플별 설정은 다음 실행에 적용되며 앱 종료 시 초기화됩니다." Style="{StaticResource Hint}"/>
                            <TextBlock Text="숨김·완료된 팝업은 다음 실행에서 제외됩니다. 다시 보려면 아래의 상태 초기화를 누르세요. 상태 초기화는 편집한 옵션을 유지합니다." Style="{StaticResource Hint}"/>
                            <!-- [Demo SSO·로그인 테스트] appsettings PopupApi.DemoSsoLoginTest=true일 때만 표시. SSO와 로그인 API를 따로 호출한다. -->
                            <StackPanel x:Name="AuthTestPanel" Visibility="Collapsed">
                                <!-- POL-14-02 : Demo 모드 — 인증 확인 도구는 샘플 작업과 분리해 접어 둔다. -->
                                <Expander Header="SSO · 로그인 테스트" IsExpanded="False" Margin="0,4,0,12">
                                <StackPanel Margin="0,8,0,0">
                                <Button x:Name="SsoTestButton" Content="SSO 테스트" Click="SsoTestButton_Click"
                                        ToolTip="Auth.SsoUrl을 Windows 통합 인증으로 호출해 MAIN_USER_ID·MAIN_USER_CLASSI_CODE를 읽습니다."/>
                                <TextBlock Text="사번 (lgonId)" Style="{StaticResource Label}"/>
                                <TextBox x:Name="AuthLogonIdText" MinHeight="30" Padding="6,4" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                                <TextBlock Text="사용자 구분 코드 (classCode)" Style="{StaticResource Label}"/>
                                <TextBox x:Name="AuthClassCodeText" MinHeight="30" Padding="6,4" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                                <Button x:Name="LoginTestButton" Content="로그인 테스트" Click="LoginTestButton_Click"
                                        ToolTip="입력한 사번·구분 코드로 서버 로그인 API를 호출합니다. SSO 테스트에 성공하면 값이 자동으로 채워집니다."/>
                                <TextBox x:Name="AuthTestResultText" Style="{StaticResource JsonText}" MinHeight="120" Margin="0,4,0,16" TextWrapping="Wrap"/>
                                </StackPanel>
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                        <!-- POL-14-02 : Demo 모드 — API Demo(-Demo -Api) 전용. 연결·인증·요청 본문을 입력하고 수동으로 호출한다. 자동 조회 없음. -->
                        <StackPanel x:Name="ApiPanel" Visibility="Collapsed">
                            <!-- POL-14-02 : Demo 모드 — 현재 대상·인증 상태는 항상 보이고, 연결·인증 입력은 접을 수 있다(연결 적용 성공 시 자동 접힘, 입력 오류 시 펼침). -->
                            <Border Background="#F5F6F8" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                <TextBlock x:Name="ApiConnectionSummaryText" TextWrapping="Wrap" Foreground="#374151" LineHeight="20"
                                           Text="연결 미적용 · 아래 설정을 입력하고 '연결 적용' 또는 '팝업 조회'를 누르세요."/>
                            </Border>
                            <Expander x:Name="ApiConnectionExpander" Header="연결·인증 설정" IsExpanded="True" Margin="0,0,0,10">
                                <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Base URL" Style="{StaticResource Label}"/>
                                <TextBox x:Name="ApiBaseUrlText" MinHeight="30" Padding="6,4" Margin="0,0,0,10" VerticalContentAlignment="Center"
                                         ToolTip="예: http://dev-host:8080/zero-rule-server/p (끝의 /는 무시)"/>
                                <TextBlock Text="인증 방식" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="ApiAuthModeCombo" SelectedIndex="0" Margin="0,0,0,10" SelectionChanged="ApiAuthModeCombo_SelectionChanged">
                                    <ComboBoxItem Content="로그인 API 호출 후 토큰 사용" Tag="LOGIN"/>
                                    <ComboBoxItem Content="토큰 직접 입력" Tag="TOKEN"/>
                                    <ComboBoxItem Content="인증 헤더 없음" Tag="NONE"/>
                                </ComboBox>
                                <StackPanel x:Name="ApiLoginPanel">
                                    <TextBlock Text="로그인 경로" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="ApiLoginPathText" MinHeight="30" Padding="6,4" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="로그인 요청 JSON" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="ApiLoginBodyText" FontFamily="Consolas" FontSize="12" Padding="6,4" Margin="0,0,0,10"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/>
                                </StackPanel>
                                <StackPanel x:Name="ApiTokenPanel" Visibility="Collapsed">
                                    <TextBlock Text="Authorization 토큰" Style="{StaticResource Label}"/>
                                    <PasswordBox x:Name="ApiTokenBox" MinHeight="30" Padding="6,4" Margin="0,0,0,4" VerticalContentAlignment="Center"
                                                 ToolTip="토큰만 넣으면 'Bearer '를 붙입니다. 'Bearer xxx'처럼 스킴까지 넣어도 됩니다."/>
                                    <TextBlock Text="토큰만 넣으면 'Bearer '를 붙입니다. 401이어도 재로그인하지 않습니다." Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                                </StackPanel>
                                <TextBlock Text="X-Dev-User-Id (선택)" Style="{StaticResource Label}"/>
                                <TextBox x:Name="ApiDevUserIdText" MinHeight="30" Padding="6,4" Margin="0,0,0,10" VerticalContentAlignment="Center"
                                         ToolTip="서버 dev-user-header 프로파일 전용. 비우면 헤더를 보내지 않습니다."/>
                                <Button x:Name="ApiApplyButton" Content="연결 적용" Click="ApiApplyButton_Click"
                                        ToolTip="입력한 Base URL·인증·사용자로 API 서비스와 결과 큐를 만듭니다. 조회·로그인 때도 바뀐 값이 있으면 자동 적용합니다."/>
                                <Button x:Name="ApiLoginButton" Content="로그인" Click="ApiLoginButton_Click"
                                        ToolTip="로그인 요청 JSON으로 로그인 API를 지금 호출하고 토큰을 교체합니다."/>
                                </StackPanel>
                            </Expander>
                            <TextBlock Text="단건 조회 요청 JSON" Style="{StaticResource Label}" Margin="0,8,0,6"/>
                            <TextBox x:Name="ApiQueryBodyText" FontFamily="Consolas" FontSize="12" Padding="6,4" Margin="0,0,0,10"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" Text="{}{}"/>
                            <CheckBox x:Name="ApiRevealSecretsCheck" Content="토큰 평문 표시 (화면만)" Margin="0,4,0,12"
                                      Checked="ApiRevealSecretsCheck_Changed" Unchecked="ApiRevealSecretsCheck_Changed"/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="수동 모드입니다. 자동 폴링을 하지 않으며 결과 응답의 nextStatus가 AVAILABLE이어도 다음 조회는 '팝업 조회' 버튼으로 실행합니다. 실제 전달 건·결과가 서버에 생성됩니다."/>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="미전송 결과는 Base URL·인증 대상·사용자별 파일에 보관해 다른 연결로 보내지 않습니다. 토큰은 메모리에만 두고 파일에 남기지 않습니다."/>
                        </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <!-- POL-14-02 : Demo 모드 — 주 실행 버튼은 스크롤 영역 밖 하단에 고정해 작은 창에서도 항상 보이게 한다. -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <!-- POL-14-02 : Demo 모드 — 현재 실행 상태(대기·조회/요청 중·팝업 표시 중·결과 전송 중·실패). 진행 중에는 실행 버튼을 막는다. -->
                        <TextBlock x:Name="RunStateText" Text="대기" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,8" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <StackPanel x:Name="InMemoryActionBar">
                            <Button x:Name="LocalRunButton" Content="선택한 샘플 실행" Style="{StaticResource PrimaryButton}" Click="OpenSelectedPopupButton_Click"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="LocalRunAllButton" Content="전체 실행" Click="OpenAllPopupsButton_Click" ToolTip="모든 유형의 샘플을 서버 순서대로 이어서 표시합니다."/>
                                <Button x:Name="LocalResetStateButton" Grid.Column="2" Content="상태 초기화" Click="ResetServerButton_Click"
                                        ToolTip="숨김·완료·유예·전달 건·영수증을 초기화합니다. 편집한 옵션과 로그는 유지합니다."/>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="ApiActionBar" Visibility="Collapsed">
                            <Button x:Name="ApiQueryButton" Content="팝업 조회 (POST /api/wpf/popups)" Style="{StaticResource PrimaryButton}" Click="ApiQueryButton_Click"/>
                            <Button x:Name="ApiFlushButton" Content="미전송 결과 재전송" Click="ApiFlushButton_Click"
                                    ToolTip="보관 중인 결과를 같은 resultId·본문으로 다시 보냅니다."/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Row="3" BorderBrush="#E0E3E8" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,12,0,0">
                        <TextBlock x:Name="ServerStateText" Foreground="#68707C" Text="숨김 0 · 완료 0"/>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" BorderBrush="#E0E3E8" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="0.7*"/>
                        <RowDefinition Height="8"/><RowDefinition Height="1.3*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="로그 지우기" Margin="12,0,0,0" Padding="10,6" Click="ClearLogButton_Click"
                                ToolTip="화면 로그와 요청·응답 상세만 지웁니다. 샘플 옵션·서버 상태·미전송 결과는 그대로입니다."/>
                        <TextBlock Text="조회 · 결과 전송 로그" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <!-- POL-14-02 : Demo 모드 — 퀴즈 점수는 결과 로그 줄에도 남기고, 이 상자는 점수가 생겼을 때만 보인다(로컬 샘플). -->
                    <Border x:Name="QuizScoreBorder" Grid.Row="1" Background="#F5F6F8" CornerRadius="6" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock x:Name="QuizScoreText" Text="퀴즈 완료 후 점수와 통과 여부가 표시됩니다." TextWrapping="Wrap" Foreground="#374151"/>
                    </Border>
                    <ListBox Grid.Row="2" x:Name="ResultLogList" FontFamily="Consolas" FontSize="12" BorderBrush="#E0E3E8"
                             SelectionChanged="ResultLogList_SelectionChanged" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="#E0E3E8" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>
                    <TabControl x:Name="DetailTabs" Grid.Row="4" BorderThickness="0">
                        <TabItem Header="Request · 요청">
                            <DockPanel Margin="0,8,0,0">
                                <Button x:Name="CopyRequestButton" DockPanel.Dock="Top" Content="요청 JSON 복사" HorizontalAlignment="Right" IsEnabled="False" Tag="REQUEST" Click="CopyJsonButton_Click"/>
                                <TextBox x:Name="RequestJsonText" Style="{StaticResource JsonText}"/>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Response · 응답">
                            <DockPanel Margin="0,8,0,0">
                                <Button x:Name="CopyResponseButton" DockPanel.Dock="Top" Content="응답 JSON 복사" HorizontalAlignment="Right" IsEnabled="False" Tag="RESPONSE" Click="CopyJsonButton_Click"/>
                                <TextBox x:Name="ResponseJsonText" Style="{StaticResource JsonText}"/>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                    <TextBlock Grid.Row="5" x:Name="CopyStatusText" Text="로그를 선택하면 요청·응답 JSON을 확인하고 복사할 수 있습니다." Foreground="#68707C" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
