<Window x:Class="Popup.DemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Popup Demo Mode" Height="720" Width="1000" MinHeight="700" MinWidth="820" ShowInTaskbar="True">
    <!--
        Demo Mode 화면 (Java 서버·DB 없이 동작)
        왼쪽: 샘플 팝업 실행 버튼. 오른쪽: 결과 API 시뮬레이션 로그.
        새 구조(기준 3·4)에서는 팝업이 닫힐 때 결과 항목 1개가 전송되므로,
        그 항목과 "서버"(DemoPopupGateway)의 응답을 그대로 보여 준다.
    -->
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel VerticalAlignment="Top">
            <TextBlock Text="Demo Mode" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="서버 없이 팝업 표시와 결과 전송 흐름을 확인합니다." TextWrapping="Wrap"
                       Foreground="#666" Margin="0,0,0,16"/>
            <GroupBox Header="새 기능 확인" Margin="0,0,0,16" Padding="10">
                <StackPanel>
                    <TextBlock Text="푸터 바로가기 URL" Margin="0,0,0,4"/>
                    <TextBox x:Name="FooterLinkInput" Text="https://example.com/" Margin="0,0,0,8"/>
                    <Button Content="바로가기 → 링크 열고 닫기" Height="36" Margin="0,0,0,12" Tag="FOOTER_LINK" Click="OpenPopupButton_Click"/>
                    <TextBlock Text="동영상 완료 비율" Margin="0,0,0,4"/>
                    <ComboBox x:Name="VideoCompletionCombo" SelectedIndex="3" Margin="0,0,0,6">
                        <ComboBoxItem Content="0%" Tag="0"/>
                        <ComboBoxItem Content="25%" Tag="0.25"/>
                        <ComboBoxItem Content="50%" Tag="0.5"/>
                        <ComboBoxItem Content="80%" Tag="0.8"/>
                        <ComboBoxItem Content="100%" Tag="1"/>
                    </ComboBox>
                    <CheckBox x:Name="VideoQuizLinkCheck" Content="동영상+퀴즈 푸터에도 바로가기 사용" Margin="0,0,0,8"/>
                    <Button Content="동영상 + 퀴즈 실행" Height="36" Margin="0,0,0,6" Tag="VIDEO_QUIZ" Click="OpenPopupButton_Click"/>
                    <TextBlock Text="설정 비율까지 시청하면 퀴즈와 푸터가 활성화됩니다. 퀴즈 완료 점수는 오른쪽 결과 JSON에서 확인하세요." TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,12"/>
                    <Button Content="ORIGINAL 이미지 · 원본 그대로 자르기" Height="36" Tag="IMAGE_ORIGINAL" Click="OpenPopupButton_Click"/>
                </StackPanel>
            </GroupBox>
            <TextBlock Text="1번 문항 선택지 배치" Margin="0,0,0,4"/>
            <ComboBox x:Name="Question1LayoutCombo" SelectedIndex="0" Margin="0,0,0,8">
                <ComboBoxItem Content="세로형" Tag="VERTICAL"/>
                <ComboBoxItem Content="가로형 (너비 초과 시 줄바꿈)" Tag="HORIZONTAL"/>
            </ComboBox>
            <TextBlock Text="2번 문항 선택지 배치" Margin="0,0,0,4"/>
            <ComboBox x:Name="Question2LayoutCombo" SelectedIndex="1" Margin="0,0,0,8">
                <ComboBoxItem Content="세로형" Tag="VERTICAL"/>
                <ComboBoxItem Content="가로형 (너비 초과 시 줄바꿈)" Tag="HORIZONTAL"/>
            </ComboBox>
            <TextBlock Text="문항별 배치를 선택한 뒤 설문·퀴즈를 여세요. 긴 보기와 공백 없는 문구도 확인할 수 있습니다." TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,8"/>
            <Button Content="전체 팝업 순차 실행" Height="40" Margin="0,0,0,10" Click="OpenAllPopupsButton_Click"/>
            <Button Content="텍스트 팝업 열기" Height="36" Margin="0,0,0,8" Tag="TEXT" Click="OpenPopupButton_Click"/>
            <Button Content="이미지 팝업 열기" Height="36" Margin="0,0,0,8" Tag="IMAGE" Click="OpenPopupButton_Click"/>
            <ComboBox x:Name="ImageModeCombo" SelectedIndex="0" Margin="0,0,0,8">
                <ComboBoxItem Content="ORIGINAL · 원본 그대로 자르기" Tag="ORIGINAL"/>
                <ComboBoxItem Content="ADAPTIVE · 화면에 맞춤" Tag="ADAPTIVE"/>
                <ComboBoxItem Content="FIT_TO_IMAGE · 원본에 맞춤" Tag="FIT_TO_IMAGE"/>
                <ComboBoxItem Content="FILL · 꽉 채우기" Tag="FILL"/>
            </ComboBox>
            <Button Content="비디오 팝업 열기" Height="36" Margin="0,0,0,8" Tag="VIDEO" Click="OpenPopupButton_Click"/>
            <Button Content="설문 팝업" Height="36" Margin="0,0,0,8" Tag="SURVEY" Click="OpenPopupButton_Click"/>
            <Button Content="퀴즈 팝업" Height="36" Margin="0,0,0,20" Tag="QUIZ" Click="OpenPopupButton_Click"/>
            <Button Content="서버 상태 초기화 (숨김·완료)" Height="34" Margin="0,0,0,8" Click="ResetServerButton_Click"/>
            <Button Content="결과 로그 지우기" Height="34" Click="ClearLogButton_Click"/>
            <TextBlock x:Name="ServerStateText" Margin="0,16,0,0" Foreground="#444" TextWrapping="Wrap"
                       Text="숨김 0 · 완료 0"/>
        </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="결과 전송 JSON" FontWeight="SemiBold"/>
                <TextBlock x:Name="QuizScoreText" Text="퀴즈 완료 후 score / passed가 여기에 표시됩니다." TextWrapping="Wrap" Margin="0,8,0,0" FontSize="16" Foreground="#2563EB"/>
            </StackPanel>
            <ListBox Grid.Row="1" x:Name="ResultLogList" FontFamily="Consolas" FontSize="12"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="#666" TextWrapping="Wrap"
                       Text="숨김·완료된 팝업은 실제 서버와 같이 다음 조회에서 제외됩니다. 퀴즈 완료 요청 JSON에는 score·passed가 포함됩니다. 다시 확인하려면 서버 상태를 초기화하세요."/>
        </Grid>
    </Grid>
</Window>
